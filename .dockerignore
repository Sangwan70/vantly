# We want the docker builds to be clean, and as fast as possible. Don't send
# any half-built stuff in the build context as a pre-caution (also saves copying
# 180k files in node_modules that isn't used!).
**/node_modules
node_modules/*
node_modules
docker-data/*
dist
.nx
/apps/frontend/.next
/apps/backend/dist
/apps/workers/dist
/apps/cron/dist
/apps/commands/dist
.devcontainer
**/.git
**/*.md
**/LICENSE
**/npm-debug.log
**/*.vscode
.git
.github
reports

# Docker's own data-root (relocated here) and scratch/cleanup folders -
# root-owned internals under these break the build context transfer with
# a permission-denied error, and neither belongs in an image anyway.
.docker
_to_delete

# Never bake gitignored, developer-local env files into the image. Next.js
# auto-loads .env.local during `next build` regardless of NODE_ENV, which
# previously baked its localhost NEXT_PUBLIC_* values into the production
# bundle for every visitor (see Dockerfile.dev comment above the
# NEXT_PUBLIC_* ARG/ENV pairs). .env.prod's real secrets don't belong in
# an image layer either - it's only ever needed on the host, to resolve
# docker-compose.yaml's ${...} placeholders via --env-file.
.env.local
.env.prod

// ─── Mailer ───────────────────────────────────────────────────────────────

enum EmailGroupType {
  MANUAL
  ALL_USERS
  SMART
}

// Recipient list for admin mailer campaigns, targeting this platform's own
// Users (mirrors the original "Subscribers / Free / All, for mailer
// campaigns" admin request) - NOT per-organization contacts.
//   MANUAL     -> memberEmails is the list
//   ALL_USERS  -> every User, resolved live at send time
//   SMART      -> smartRules (e.g. {"hasSubscription": true}) evaluated
//                 live against User/Subscription at send time
// See mailer-recipients.service.ts for resolution.
model EmailGroup {
  id           String         @id @default(uuid())
  name         String
  description  String?
  type         EmailGroupType @default(MANUAL)
  memberEmails String[]       @default([])
  smartRules   Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  campaigns    EmailCampaign[]

  @@index([type])
}

// A reusable email design. htmlContent is the final email-safe HTML
// (table-based layout); when it was authored in the drag-and-drop
// Template Designer, htmlContent also carries a leading
// `<!--BUILDER_STATE:<base64 json>-->` comment so re-opening the template
// restores the structured block state instead of falling back to
// source-HTML mode - same round-trip trick as vantly-ugc's
// serialize.ts/deserializeBuilderState. isSample flags the seeded starter
// templates so the admin UI can show them in a separate "Start from a
// sample" picker without an admin being able to accidentally overwrite
// them out of the main list (the UI always "duplicates" a sample instead
// of editing it in place).
model EmailTemplate {
  id          String   @id @default(uuid())
  name        String
  subject     String
  htmlContent String
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns   EmailCampaign[]
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

model EmailCampaign {
  id              String              @id @default(uuid())
  name            String
  subject         String
  templateId      String?
  template        EmailTemplate?      @relation(fields: [templateId], references: [id])
  groupId         String
  group           EmailGroup          @relation(fields: [groupId], references: [id])
  // Snapshot of the template's HTML at send time, so editing/deleting the
  // template later never changes what a already-sent campaign shows in
  // its own history.
  htmlContent     String
  status          EmailCampaignStatus @default(DRAFT)
  scheduledFor    DateTime?
  sentAt          DateTime?
  totalRecipients Int                 @default(0)
  sentCount       Int                 @default(0)
  failedCount     Int                 @default(0)
  // Dispatch does not run as its own Temporal workflow: sendNow() (see
  // EmailCampaignService) batches recipients and calls the existing
  // EmailService.sendEmail() per message, which itself signals the
  // pre-existing durable sendEmailWorkflow queue (workflowId:'send_email').
  // That queue's own per-message idempotency is what's relied on here, so
  // no separate per-campaign workflow id is tracked on this model.
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  logs            EmailLog[]

  @@index([status])
  @@index([groupId])
}

enum EmailLogStatus {
  PENDING
  SENT
  FAILED
  OPENED
  CLICKED
}

// One row per recipient per campaign - both the delivery record and the
// open/click tracking pixel/link target (trackingToken).
model EmailLog {
  id            String         @id @default(uuid())
  campaignId    String
  campaign      EmailCampaign  @relation(fields: [campaignId], references: [id])
  email         String
  userId        String?
  status        EmailLogStatus @default(PENDING)
  trackingToken String         @unique @default(uuid())
  error         String?
  sentAt        DateTime?
  openedAt      DateTime?
  clickedAt     DateTime?
  createdAt     DateTime       @default(now())

  @@index([campaignId])
  @@index([email])
}

// Emails that must never receive another mailer send - unsubscribed,
// bounced, or complained. Keyed by email address (not userId) so
// suppression survives account deletion/recreation, matching vantly-ugc's
// email_suppressions. Checked by mailer-recipients.service.ts immediately
// before every send.
model EmailSuppression {
  id        String   @id @default(uuid())
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([email])
}
